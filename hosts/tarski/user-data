## template: jinja
{% set user = 'christopher' %}
#cloud-config
hostname: tarski

# Note: to reset cloud-init
# ssh tarski 'sudo cloud-init clean --logs && sudo reboot'

users:
  - name: {{ user }}
    groups: [sudo, video, render, audio]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAICGsu7XuIb3UwlRJgHuheyK9EoJGv6dD9fO/10hyZGhA plissken
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAII4a1FlqaEzSEvb1JZGAzx+hx2d4rxCf+E0M9BTI8gVm emojipad

apt:
  conf: |
    Acquire::Retries "3";
    Acquire::http::Timeout "60";
    Acquire::https::Timeout "60";

package_update: true
package_upgrade: true
package_reboot_if_required: false

packages:
  - git
  - curl
  - wget
  - ca-certificates

write_files:
  - path: /etc/ssh/sshd_config.d/99-fast-login.conf
    content: |
      UseDNS no
      GSSAPIAuthentication no
  - path: /etc/systemd/system/serial-getty@ttyAMA0.service.d/autologin.conf
    content: |
      [Service]
      ExecStart=
      ExecStart=-/sbin/agetty --autologin {{ user }} --noclear %I $TERM

runcmd:
  - |
    sed -i 's|^GRUB_CMDLINE_LINUX_DEFAULT="\([^"]*\)"|GRUB_CMDLINE_LINUX_DEFAULT="\1 clocksource=tsc tsc=reliable no_timer_check nohz=off processor.max_cstate=1"|' /etc/default/grub
  - update-grub
  - systemctl daemon-reload
  - systemctl restart serial-getty@ttyAMA0.service
  - systemctl restart ssh
  # Clone dotfiles repo and run full Debian setup
  - sudo -Hu {{ user }} git clone https://github.com/christopherseaman/lappy386.git /home/{{ user }}/lappy386
  - sudo -Hu {{ user }} bash -c "cd /home/{{ user }}/lappy386/tools && bash ./setup-debian.sh"
  # Fix ownership
  - chown -R {{ user }}:{{ user }} /home/{{ user }}
  - touch /home/{{ user }}/.cloud-init-done

final_message: "Cloud-init completed in $UPTIME seconds"
