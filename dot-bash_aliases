yank() {
  local content
  if [[ -f "$1" ]]; then
    content=$(cat "$1")
  else
    content=$(cat)
  fi

  if [[ -n "$TMUX" ]]; then
    # Inside tmux - use tmux's clipboard handling
    printf "%s" "$content" | tmux load-buffer -
  elif [[ "$OSTYPE" == "darwin"* ]]; then
    # macOS - use pbcopy
    printf "%s" "$content" | pbcopy
  else
    # Linux/other - direct OSC52
    printf "\033]52;c;%s\033\\" "$(printf "%s" "$content" | base64 -w0)"
  fi
}
