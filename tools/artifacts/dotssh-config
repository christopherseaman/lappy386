# Include ~/.orbstack/ssh/config  # macOS only

# Global defaults
SetEnv TERM=xterm-256color
ForwardAgent yes
IdentitiesOnly yes
User christopher
Compression yes
AddKeysToAgent yes

# macOS-specific settings
Match host * exec "test $(uname) = Darwin"
    UseKeychain yes

Host glen
  IdentityFile ~/.ssh/glen

Host schmaspberry schmaspberry.duckdns.org
  IdentityFile ~/.ssh/schmaspberry_hive

Host deb-studio deb-y7rgc54-dt deb-y7rgc54-dt-1 deb-y7rgc54
  User cseaman
  IdentityFile ~/.ssh/schmaspberry_hive

Host hivemind*
  IdentityFile ~/.ssh/hivemind

Host *.github.com
  IdentityFile ~/.ssh/github

Host minigame.duckdns.org
  IdentityFile ~/.ssh/minigame

Host carnac carnac.badmath.org 146.235.221.82
  IdentityFile ~/.ssh/carnac

Host shtheeev shtheeev.local 192.168.4.2 sqrlly.duckdns.org
  Port 222
  IdentityFile ~/.ssh/shtheeev