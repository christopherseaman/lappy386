font-family = FiraMono Nerd Font Mono
font-feature = -calt,-clig,-liga
font-size = 14
background-opacity = 0.9

# Alt + Enter
keybind = shift+enter=text:\x1b\r

# literal LF
# keybind = shift+enter=text:\x0A

theme = GitHub Dark High Contrast
background = black
foreground = white

# Use nvim to edit config file
# keybind = super+,=text:ghostty +edit-config\n

