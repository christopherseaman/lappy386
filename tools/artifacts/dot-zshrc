# ~/.zshrc: executed by zsh for interactive shells

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

# History configuration
HISTSIZE=100000
SAVEHIST=200000
HISTFILE=~/.zsh_history

# History options
setopt HIST_IGNORE_DUPS          # Don't record an entry that was just recorded again
setopt HIST_IGNORE_ALL_DUPS      # Delete old recorded entry if new entry is a duplicate
setopt HIST_FIND_NO_DUPS         # Do not display a line previously found
setopt HIST_IGNORE_SPACE         # Don't record an entry starting with a space
setopt HIST_SAVE_NO_DUPS         # Don't write duplicate entries in the history file
setopt HIST_REDUCE_BLANKS        # Remove superfluous blanks before recording entry
setopt HIST_VERIFY               # Don't execute immediately upon history expansion
setopt INC_APPEND_HISTORY        # Write to history file immediately, not when shell exits
setopt SHARE_HISTORY             # Share history between all sessions

# Homebrew setup (macOS)
if [[ "$OSTYPE" == "darwin"* ]] && [[ -f "/opt/homebrew/bin/brew" ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# Add user's private bin to PATH
export PATH="$HOME/.local/bin:$PATH"

# Load aliases if they exist (early load for potential overrides)
if [[ -f ~/.aliases ]]; then
  . ~/.aliases
fi

# Completion system
autoload -Uz compinit && compinit

# Better completion settings
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' menu select
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*:ssh:*' hosts-ports $(cat ~/.ssh/known_hosts ~/.ssh/config 2>/dev/null | awk '/^Host[[:space:]]/ { print $2 }' | grep -v '\*' | sort -u)

# Directory options
setopt AUTO_CD                   # Auto change to a directory without typing cd
setopt AUTO_PUSHD                # Push the old directory onto the stack on cd
setopt PUSHD_IGNORE_DUPS         # Do not store duplicates in the stack
setopt PUSHD_SILENT              # Do not print the directory stack after pushd or popd

# Correction and expansion
setopt CORRECT                   # Try to correct the spelling of commands
setopt GLOB_DOTS                 # Include dotfiles in globbing

# Enable colors
autoload -U colors && colors

# Colored GCC warnings and errors
export CLICOLOR=1
export GCC_COLORS='error=01;31:warning=01;35:note=01;36:caret=01;32:locus=01:quote=01'

# Define a function to load env vars from a file
load_env() {
    set -o allexport
    source $1
    set +o allexport
}

# Load ssh-agent and keys
[ -z "$SSH_AUTH_SOCK" ] && eval $(ssh-agent)
# Add client key to ssh-agent
[ -f ~/.ssh/client_key ] && ssh-add ~/.ssh/client_key &> /dev/null

# Command-specific completions
command -v gh >/dev/null && eval "$(gh completion -s zsh)"
command -v uv >/dev/null && eval "$(uv generate-shell-completion zsh)"

# Set up fzf key bindings and fuzzy completion
command -v fzf >/dev/null && source <(fzf --zsh)

# Pretty greeting!
command -v fastfetch >/dev/null && fastfetch

# Initialize starship prompt
command -v starship >/dev/null && eval "$(starship init zsh)"

# zoxide (smarter cd: z <dir>, zi to pick interactively)
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"

# Additional PATH entries (customize as needed)
[[ -d "$HOME/.duckdb/cli/latest" ]] && export PATH="$HOME/.duckdb/cli/latest:$PATH"

# Language environment
export LANG=en_US.UTF-8
export TZ='America/Los_Angeles'

# Auto-attach to tmux session on SSH login only (skip for biscuit)
[[ -n "$SSH_CONNECTION" ]] && [[ -z "$TMUX" ]] && [[ "$USER" != "biscuit" ]] && { tmux attach || tmux; }

export NVM_DIR="$HOME/.config/nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
