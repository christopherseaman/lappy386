# fastfetch greeting function
fastfetch_greeting() {
  shopt -q login_shell && {
    logos=("gnu") # "aperture"
    selected_logo=${logos[$RANDOM % ${#logos[@]}]}
    fastfetch --logo $selected_logo
  }
}

# update more easily
alias sup="sudo apt update && sudo apt full-upgrade -y --allow-change-held-packages && sudo apt autoremove -y"

# some more ls aliases
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'

# git init + push alias
alias ginit='git init && git add . && git commit -m "init" && gh repo create --private --source . --push'

# Better grep - use ripgrep if available, otherwise enhanced grep
if command -v rg &>/dev/null; then
  alias grep='rg --smart-case'
  alias rg='rg --smart-case'
  alias rgf='rg --files-with-matches'
  alias rgi='rg --no-ignore'
else
  alias grep='grep --color=auto --exclude-dir={.git,.svn,.hg}'
fi

# Use fd if available for finding files
if command -v fd &>/dev/null; then
  alias fd='fd --hidden --follow'
  alias fdi='fd --no-ignore --hidden --follow'
elif command -v fdfind &>/dev/null; then
  alias fd='fdfind --hidden --follow'
  alias fdi='fdfind --no-ignore --hidden --follow'
fi

# Better cat with syntax highlighting
if command -v bat &>/dev/null; then
  alias cat='bat --style=plain --paging=never'
elif command -v batcat &>/dev/null; then
  alias cat='batcat --style=plain --paging=never'
  alias bat='batcat'
fi

# Better disk usage
if command -v ncdu &>/dev/null; then
  alias du='ncdu --color dark'
fi

# Git delta for better diffs
if command -v delta &>/dev/null; then
  export GIT_PAGER='delta'
fi

# FZF-powered aliases if available
if command -v fzf &>/dev/null; then
  # History search with fzf
  alias h='history | fzf --tac'

  # cd to directory using fzf
  fcd() {
    local dir
    dir=$(find ${1:-.} -type d 2>/dev/null | fzf +m) && cd "$dir"
  }

  # Open file in editor using fzf
  fe() {
    local files
    IFS=$'\n' files=($(fzf --query="$1" --multi --select-1 --exit-0))
    [[ -n "$files" ]] && ${EDITOR:-vim} "${files[@]}"
  }

  # Kill process using fzf
  fkill() {
    local pid
    pid=$(ps -ef | sed 1d | fzf -m | awk '{print $2}')
    if [ "x$pid" != "x" ]; then
      echo $pid | xargs kill -${1:-9}
    fi
  }
else
  # Fallback history search
  alias h='history | grep'
fi

# Extract various archive formats
extract() {
  if [ -f "$1" ]; then
    case "$1" in
    *.tar.bz2) tar xjf "$1" ;;
    *.tar.gz) tar xzf "$1" ;;
    *.bz2) bunzip2 "$1" ;;
    *.rar) unrar e "$1" ;;
    *.gz) gunzip "$1" ;;
    *.tar) tar xf "$1" ;;
    *.tbz2) tar xjf "$1" ;;
    *.tgz) tar xzf "$1" ;;
    *.zip) unzip "$1" ;;
    *.Z) uncompress "$1" ;;
    *.7z) 7z x "$1" ;;
    *) echo "'$1' cannot be extracted via extract()" ;;
    esac
  else
    echo "'$1' is not a valid file"
  fi
}

yank() {
  local content
  if [[ -f "$1" ]]; then
    content=$(cat "$1")
  else
    content=$(cat)
  fi

  # Native pbcopy only on a bare macOS terminal (no multiplexer to tunnel through).
  if [[ "$OSTYPE" == "darwin"* ]] && [[ -z "$TMUX" ]] && [[ -z "$ZELLIJ" ]]; then
    printf "%s" "$content" | pbcopy
    return
  fi

  local b64
  b64=$(printf "%s" "$content" | base64 | tr -d '\n')
  if [[ -n "$TMUX" ]]; then
    # tmux needs OSC52 wrapped in its DCS passthrough
    printf '\033Ptmux;\033\033]52;c;%s\007\033\\' "$b64"
  else
    # zellij copies OSC52 natively; bare terminals pass it to the host
    printf '\033]52;c;%s\007' "$b64"
  fi
}

dan() {
  if ! id -u sqrlbot &>/dev/null; then
    echo "dan: sqrlbot sandbox user not found." >&2
    echo "     Create it by running setup-debian.sh (Linux) or setup-macos.sh (macOS)." >&2
    return 1
  fi
  local pre=(sudo -u sqrlbot -H)       # -H => HOME=~sqrlbot (its own ~/.claude); cwd preserved
  # run via login shell so sqrlbot's ~/.bash_profile sets PATH and (on macOS) unlocks its keychain
  case "${1:-}" in
  install | update)
    "${pre[@]}" bash -lc 'export CI=1; [ -x "$HOME/.local/bin/claude" ] && "$HOME/.local/bin/claude" install || curl -fsSL https://claude.ai/install.sh | bash'
    ;;
  *)
    "${pre[@]}" bash -lc 'exec "$HOME/.local/bin/claude" --dangerously-skip-permissions "$@"' _ "$@"
    ;;
  esac
}
alias bye='if [ -n "$TMUX" ]; then tmux detach -P; elif [ -n "$ZELLIJ" ]; then zellij action detach; else exit; fi'

