"$schema" = 'https://starship.rs/config-schema.json'

format = """
[](red)\
$os\
$hostname\
$username\
[](bg:green fg:red)\
$directory\
[](bg:yellow fg:green)\
$git_branch\
$git_status\
[](fg:yellow bg:blue)\
$c\
$rust\
$golang\
$nodejs\
$php\
$java\
$kotlin\
$haskell\
$python\
[](fg:blue bg:purple)\
$conda\
[](fg:purple bg:cyan)\
$time\
[ ](fg:cyan)\
$cmd_duration\
$line_break\
$character"""

palette = 'ansi'

[os]
disabled = false
style = "bg:red fg:crust"

[os.symbols]
Windows = ""
Ubuntu = "󰕈"
SUSE = ""
Raspbian = "󰐿"
Mint = "󰣭"
Macos = "󰀵"
Manjaro = ""
Linux = "󰌽"
Gentoo = "󰣨"
Fedora = "󰣛"
Alpine = ""
Amazon = ""
Android = ""
AOSC = ""
Arch = "󰣇"
Artix = "󰣇"
CentOS = ""
Debian = "󰣚"
Redhat = "󱄛"
RedHatEnterprise = "󱄛"

[username]
disabled = true

[hostname]
disabled = false
ssh_only = false
style = "bg:red fg:crust"
format = "[ $hostname ]($style)"

[hostname.aliases]
"DEB-5670H9F-LT" = "󱔎"                   # nf-md-snake U+F150E (plissken)
"plissken.home" = "󱔎"                    # nf-md-snake U+F150E
"plissken" = "󱔎"                         # nf-md-snake U+F150E
"DEB-Y7RGC54-DT" = "󰏘"                   # nf-md-palette U+F03D8 (deb-studio)
"deb-studio.home" = "󰏘"                  # nf-md-palette U+F03D8
"deb-studio" = "󰏘"                       # nf-md-palette U+F03D8
"glen.home" = "󰆼"                        # nf-md-database U+F01BC
"glen" = "󰆼"                             # nf-md-database U+F01BC
"carnac.home" = "󱑷"                      # nf-md-wizard_hat U+F1477
"carnac" = "󱑷"                           # nf-md-wizard_hat U+F1477
"minigame.home" = "󱎓"                    # nf-md-nintendo_game_boy U+F1393
"minigame" = "󱎓"                         # nf-md-nintendo_game_boy U+F1393
"hivemind.home" = "󱃎"                    # nf-md-beehive_outline U+F10CE
"hivemind" = "󱃎"                         # nf-md-beehive_outline U+F10CE
"schmaspberry.home" = "󱁄"                # nf-md-fruit_grapes U+F1044
"schmaspberry" = "󱁄"                     # nf-md-fruit_grapes U+F1044
"spaceforce.home" = "󱓞"                  # nf-md-rocket_launch U+F14DE
"spaceforce" = "󱓞"                       # nf-md-rocket_launch U+F14DE
"tarski.home" = "󰿉"                      # nf-md-math_integral_box U+F0FC9
"tarski" = "󰿉"                           # nf-md-math_integral_box U+F0FC9

[directory]
style = "bg:green fg:crust"
format = "[ $path ]($style)"
truncation_length = 3
truncation_symbol = "…/"
substitutions = [
  # Match complete path components so names such as "MyDocuments" remain unchanged.
  { from = '(^|[/\\])Documents([/\\]|$)', to = '${1}󰈙${2}', regex = true },       # nf-md-file_document U+F0219
  { from = '(^|[/\\])Downloads([/\\]|$)', to = '${1}󰇚${2}', regex = true },       # nf-md-download U+F01DA
  { from = '(^|[/\\])Music([/\\]|$)', to = '${1}󰝚${2}', regex = true },           # nf-md-music U+F075A
  { from = '(^|[/\\])Pictures([/\\]|$)', to = '${1}󰋩${2}', regex = true },        # nf-md-image U+F02E9
  { from = '(^|[/\\])Developer([/\\]|$)', to = '${1}󰲋${2}', regex = true },       # nf-md-code_braces_box U+F0C8B
  { from = '(^|[/\\])Movies([/\\]|$)', to = '${1}󰿎${2}', regex = true },          # nf-md-filmstrip U+F0FCE
  { from = '(^|[/\\])Dropbox([/\\]|$)', to = '${1}󰇣${2}', regex = true },         # nf-md-dropbox U+F01E3
  { from = '(^|[/\\])Games([/\\]|$)', to = '${1}󰊗${2}', regex = true },           # nf-md-gamepad_variant U+F0297
  { from = '(^|[/\\])projects([/\\]|$)', to = '${1}󰅩${2}', regex = true },        # nf-md-code_braces U+F0169
  { from = '(^|[/\\])Desktop([/\\]|$)', to = '${1}󰇤${2}', regex = true },         # nf-md-desktop_mac U+F01E4
  { from = '(^|[/\\])Applications([/\\]|$)', to = '${1}󰀻${2}', regex = true },    # nf-md-apps U+F003B
  { from = '(^|[/\\])Library([/\\]|$)', to = '${1}󰂺${2}', regex = true },         # nf-md-book_open_variant U+F00BA
  { from = '(^|[/\\])Public([/\\]|$)', to = '${1}󰖟${2}', regex = true },          # nf-md-earth U+F059F
  { from = '(^|[/\\])OneDrive - UCSF([/\\]|$)', to = '${1}󰁯${2}', regex = true }, # nf-md-cloud U+F006F
  { from = '(^|[/\\])Reading([/\\]|$)', to = '${1}󰂿${2}', regex = true },         # nf-md-book_open_page_variant U+F00BF
  { from = '(^|[/\\])Camera Uploads([/\\]|$)', to = '${1}󰄀${2}', regex = true },  # nf-md-camera U+F0100
]

[git_branch]
symbol = ""
style = "bg:yellow"
format = '[[ $symbol $branch ](fg:crust bg:yellow)]($style)'

[git_status]
style = "bg:yellow"
format = '[[($all_status$ahead_behind )](fg:crust bg:yellow)]($style)'

[nodejs]
symbol = ""
style = "bg:blue"
format = '[[ $symbol ](fg:crust bg:blue)]($style)'

[c]
symbol = " "
style = "bg:blue"
format = '[[ $symbol ](fg:crust bg:blue)]($style)'

[rust]
symbol = ""
style = "bg:blue"
format = '[[ $symbol ](fg:crust bg:blue)]($style)'

[golang]
symbol = ""
style = "bg:blue"
format = '[[ $symbol ](fg:crust bg:blue)]($style)'

[php]
symbol = ""
style = "bg:blue"
format = '[[ $symbol ](fg:crust bg:blue)]($style)'

[java]
symbol = " "
style = "bg:blue"
format = '[[ $symbol ](fg:crust bg:blue)]($style)'

[kotlin]
symbol = ""
style = "bg:blue"
format = '[[ $symbol ](fg:crust bg:blue)]($style)'

[haskell]
symbol = ""
style = "bg:blue"
format = '[[ $symbol ](fg:crust bg:blue)]($style)'

[python]
symbol = ""
style = "bg:blue"
format = '[[ $symbol(\(#$virtualenv\)) ](fg:crust bg:blue)]($style)'

[docker_context]
symbol = ""
style = "bg:purple"
format = '[[ $symbol( $context) ](fg:crust bg:purple)]($style)'

[conda]
symbol = "  "
style = "fg:crust bg:purple"
format = '[$symbol$environment ]($style)'
ignore_base = false

[time]
disabled = true
time_format = "%I:%M %p"
style = "bg:cyan"
format = '[[  $time ](fg:crust bg:cyan)]($style)'

[line_break]
disabled = false

[character]
disabled = false
success_symbol = '[❯](bold fg:green)'
error_symbol = '[❯](bold fg:red)'
vimcmd_symbol = '[❮](bold fg:green)'
vimcmd_replace_one_symbol = '[❮](bold fg:cyan)'
vimcmd_replace_symbol = '[❮](bold fg:cyan)'
vimcmd_visual_symbol = '[❮](bold fg:yellow)'

[cmd_duration]
show_milliseconds = true
format = " in $duration "
style = "bg:cyan"
disabled = false
show_notifications = true
min_time_to_notify = 45000

[palettes.ansi]
# Only crust is fixed; every other color name resolves to the terminal ANSI palette.
crust = "#0a0c10"
